{
  "name": "paladinscat-backend",
  "version": "1.0.0",
  "description": "Paladins stats & meta analysis API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "relay:legacy": "tsx hirez-relay/server.ts",
    "prebuild": "npm run test:build-policies",
    "build": "tsc",
    "build:container": "npm run test:relay-contract && tsc && node scripts/copy-relay-operation-contract.mjs",
    "postbuild": "node scripts/copy-relay-operation-contract.mjs",
    "start": "node dist/index.js",
    "start:relay:legacy": "node dist/hirez-relay/server.js",
    "test": "tsx scripts/test-api.ts",
    "test:broken-skin": "tsx scripts/test-broken-skin-recovery.ts",
    "test:match-pipeline-e2e": "tsx scripts/test-match-pipeline-mock-e2e.ts",
    "test:relay-resolution-compare": "node ../../dev/benchmarks/compare-relay-http-contract.mjs",
    "test:batch-int16": "tsx --test test/batch-int16-preservation.test.ts",
    "test:profile-batching": "tsx --test test/player-profile-batching.test.ts",
    "test:requested-match": "tsx --test test/requested-match-ingestion.test.ts",
    "test:match-bans": "tsx --test test/match-bans.test.ts test/requested-match-ingestion.test.ts",
    "test:match-moderation": "tsx --test test/match-moderation.test.ts",
    "test:player-loadouts": "tsx --test test/player-loadout-request.test.ts",
    "test:player-status": "tsx --test test/player-status-normalizer.test.ts",
    "test:player-champions": "tsx --test test/player-champion-stats.test.ts",
    "test:private-accounts": "tsx --test test/private-account-resolver.test.ts",
    "test:deployment": "tsx --test test/deployment-control.test.ts",
    "test:security": "tsx --test test/request-security.test.ts test/developer-api.test.ts",
    "test:build-policies": "tsx --test test/match-count-discovery-policy.test.ts test/buffer-priority-policy.test.ts test/relay-operation-contract.test.ts test/provider-boundary.test.ts test/migration-inventory.test.ts test/nonranked-raw-json.test.ts",
    "test:relay-contract": "tsx --test test/relay-operation-contract.test.ts",
    "test:match-count-policy": "tsx --test test/match-count-discovery-policy.test.ts",
    "forecast:recovery": "tsx scripts/recovery-budget-forecast.ts",
    "backfill:private-accounts": "tsx scripts/backfill-private-accounts.ts",
    "migration:inventory": "node scripts/generate-rust-migration-inventory.mjs",
    "migration:verify-rust-routes": "node scripts/verify-rust-route-inventory.mjs",
    "code-map:generate": "node scripts/generate-code-map.mjs",
    "migration:test-http-compat": "node --test ../../dev/compat/backend-rust/http-compat.test.mjs",
    "migration:test-side-effect-compat": "tsx --test test/backend-side-effect-compat.test.ts",
    "migration:test-worker-trace-compat": "node --test ../../dev/compat/backend-rust/worker-trace-compat.test.mjs",
    "migration:test-scheduler-acquisition-parity": "node --test ../../dev/compat/backend-rust/scheduler-acquisition-parity.test.mjs",
    "migration:compare-http": "node ../../dev/compat/backend-rust/compare-http.mjs",
    "migration:compare-side-effects": "tsx scripts/backend-side-effect-compat.ts",
    "migration:compare-worker-traces": "node ../../dev/compat/backend-rust/worker-trace-compat.mjs",
    "migration:serve-route-compat": "tsx scripts/start-route-compat-server.ts",
    "migration:compare": "tsx scripts/compare-db-migration.ts",
    "migration:deploy": "node dist/scripts/apply-migrations.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "meilisearch": "^0.41.0",
    "node-cron": "^4.2.1",
    "p-limit": "^3.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
