        "method": "GET",
        "path": "/health"
      },
      "normalize": [
        { "operation": "replace", "pointer": "/body/timestamp", "value": "<timestamp>" }
      ],
      "assertions": [
        { "pointer": "/status", "equals": 200 },
        { "pointer": "/body/status", "equals": "degraded" },
        { "pointer": "/body/db", "equals": true },
